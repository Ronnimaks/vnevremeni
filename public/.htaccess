# Правила веб-сервера для сайта клуба «Вне времени».
#
# ВАЖНО: если в панели хостинга менять версию PHP, панель дописывает сюда свою
# строку. Она нужна — при следующей выкладке её надо сохранить, иначе сайт
# вернётся на старый PHP и серверная часть перестанет работать.

RewriteEngine On

# --- Адреса -----------------------------------------------------------------

# www склеиваем с основным адресом: две копии сайта в поиске нам не нужны.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Только https. Условие по имени домена — чтобы технический адрес хостинга,
# на котором сертификата нет, продолжал открываться для проверок.
#
# ВРЕМЕННО ОТКЛЮЧЕНО на время переезда: сертификат выпускается только после того,
# как домен начнёт смотреть на новый хостинг, а до этого момента принудительный
# https положил бы сайт целиком. Включить обратно сразу после выпуска сертификата.
# RewriteCond %{HTTP_HOST} vnevremeni-club\.ru [NC]
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Короткие адреса серверной части. Сайт обращается к /booking, а не к
# /booking.php — так адрес не завязан на язык, на котором это написано.
RewriteRule ^booking/?$ booking.php [L]
RewriteRule ^auth/?$ auth.php [L]
RewriteRule ^callback/?$ callback.php [L]

# --- Доступ -----------------------------------------------------------------

# Вспомогательный файл открывать снаружи незачем.
<Files "club-lib.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# --- Сжатие -----------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Кеш --------------------------------------------------------------------
#
# В именах файлов сборки есть отпечаток содержимого (index-a1b2c3.js), поэтому
# их можно кешировать надолго: при изменении меняется имя. А саму страницу
# кешировать нельзя — иначе браузер будет тянуть старую версию со ссылками
# на файлы, которых уже нет.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType video/mp4                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|jpeg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
