# Куски кода кабинета — это побайтовые отрезки одного файла, а не текст.
# Без этой строки Git на разных системах правил бы в них переводы строк,
# склеенный файл переставал бы совпадать с исходным, и кабинет молча ломался бы.
public/kabinet/chasti/* binary
public/kabinet/sveltia-cms.js -text
public/kabinet/locales/*.json -text
