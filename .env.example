# Адрес обработчика заявок (Cloudflare Pages Function из site/functions/booking.js).
# Секретом не является — попадает в собранный код сайта и виден в браузере.
# Токен бота сюда класть нельзя: он живёт в секретах проекта на Cloudflare.
#
# Обработчик стоит на том же домене, что и сайт. Отдельные адреса площадок
# (workers.dev, затем pages.dev) по очереди перестали открываться у российских
# провайдеров, и заявки у части гостей молча не доходили.
#
# Локально: скопировать этот файл в .env и подставить свой адрес.
# На Cloudflare Pages: задать ту же переменную в настройках сборки проекта.
VITE_BOOKING_ENDPOINT=https://ВАШ-ДОМЕН/booking

# Номер счётчика Яндекс.Метрики. Без него счётчик не подключается.
VITE_METRIKA_ID=
